diff -ruN -x .build -x .swiftpm -x *.xcodeproj -x DerivedData <fixture>/Packages/lib-DesignSystem/Sources/DesignSystem/ScreenTracking.swift <run>/Packages/lib-DesignSystem/Sources/DesignSystem/ScreenTracking.swift
